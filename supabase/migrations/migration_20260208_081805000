-- Create profiles table
create table public.profiles (
  id uuid references auth.users on delete cascade primary key,
  username text unique,
  full_name text,
  avatar_url text,
  role text default 'member' check (role in ('member', 'coach')),
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- Create running_plans table
create table public.running_plans (
  id uuid default gen_random_uuid() primary key,
  coach_id uuid references public.profiles(id) on delete cascade not null,
  title text not null,
  description text,
  target_distance numeric not null, -- in km
  start_date date not null,
  end_date date not null,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- Create running_logs table
create table public.running_logs (
  id uuid default gen_random_uuid() primary key,
  user_id uuid references public.profiles(id) on delete cascade not null,
  distance numeric not null, -- in km
  feeling text,
  log_date date default current_date not null,
  created_at timestamp with time zone default timezone('utc'::text, now()) not null
);

-- Enable RLS
alter table public.profiles enable row level security;
alter table public.running_plans enable row level security;
alter table public.running_logs enable row level security;

-- Profiles policies
create policy "Public profiles are viewable by everyone." on public.profiles
  for select using (true);

create policy "Users can insert their own profile." on public.profiles
  for insert with check (auth.uid() = id);

create policy "Users can update own profile." on public.profiles
  for update using (auth.uid() = id);

-- Running plans policies
create policy "Running plans are viewable by everyone." on public.running_plans
  for select using (true);

create policy "Coaches can insert running plans." on public.running_plans
  for insert with check (
    exists (
      select 1 from public.profiles
      where id = auth.uid() and role = 'coach'
    )
  );

create policy "Coaches can update their own running plans." on public.running_plans
  for update using (coach_id = auth.uid());

-- Running logs policies
create policy "Running logs are viewable by everyone." on public.running_logs
  for select using (true);

create policy "Users can insert their own running logs." on public.running_logs
  for insert with check (auth.uid() = user_id);

create policy "Users can update their own running logs." on public.running_logs
  for update using (auth.uid() = user_id);

-- Create a trigger to create a profile on signup
create function public.handle_new_user()
returns trigger as $$
begin
  insert into public.profiles (id, full_name, avatar_url, role)
  values (new.id, new.raw_user_meta_data->>'full_name', new.raw_user_meta_data->>'avatar_url', coalesce(new.raw_user_meta_data->>'role', 'member'));
  return new;
end;
$$ language plpgsql security definer;

create trigger on_auth_user_created
  after insert on auth.users
  for each row execute procedure public.handle_new_user();

-- Enable Realtime
alter publication supabase_realtime add table public.profiles;
alter publication supabase_realtime add table public.running_plans;
alter publication supabase_realtime add table public.running_logs;
